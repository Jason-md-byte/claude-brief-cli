{
  "name": "claude-brief-cli",
  "version": "0.1.0",
  "description": "Turn messy notes into a structured brief (summary, decisions, action items with owners) using Claude.",
  "type": "module",
  "bin": {
    "claude-brief": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "start": "node dist/index.js"
  },
  "keywords": [
    "claude",
    "anthropic",
    "cli",
    "meeting-notes",
    "summarizer"
  ],
  "license": "MIT",
  "author": "Jason Yabes",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "zod": "^4.6.7"
  }
}
